# Databricks App Database Resource injects these automatically:
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=
PGSSLMODE=require

# Non-secret Lakebase endpoint resource name used to mint short-lived OAuth DB credentials:
ENDPOINT_NAME=projects/dataexpert-support-app/branches/production/endpoints/primary

# Embedding configuration:
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# NWS asks clients to identify themselves. No API key is used.
NWS_USER_AGENT=DataExpertWeatherVectorHomework/1.0 (github.com/PedroD1265/dataexpert-weather-vector-retrieval)
